{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cohort Sync API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cohort Sync",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sync Cohort Members",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-{dc}.moengage.com/v1/integrations/cohortsync",
            "headers": [
              {
                "name": "MOE-APPKEY",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API adds or removes a list of users from a custom segment (cohort) in MoEngage."
        }
      ]
    }
  ],
  "bundled": true
}