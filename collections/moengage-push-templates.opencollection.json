{
  "opencollection": "1.0.0",
  "info": {
    "name": "Push Templates API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Push Template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-{dc}.moengage.com/v1.0/custom-templates/push",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API creates a new push notification template for one or more platforms (Android, iOS).\n"
        },
        {
          "info": {
            "name": "Update Push Template",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api-{dc}.moengage.com/v1.0/custom-templates/push",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API updates an existing push notification template by creating a new version.\n"
        },
        {
          "info": {
            "name": "Search for Push Templates",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-{dc}.moengage.com/v1.0/custom-templates/push/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API searches the push templates created in your MoEngage account.\n"
        }
      ]
    }
  ],
  "bundled": true
}