  "item": [
    {
      "id": "ce68bb5d-f3b7-4d45-90f7-a67c6d6e46ba",
      "name": "Content Blocks",
      "description": {
        "content": "Use these operations to programmatically fetch, create, and update reusable content blocks.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "afd4c5f7-c4c0-4d80-8a6d-845fe55d23e9",
          "name": "Create Content Block",
          "request": {
            "name": "Create Content Block",
            "description": {
              "content": "This API creates a content block in MoEngage.\n\nUse the `source` field in the request body to specify the communication type for the content block:\n- `\"source\": \"ENGAGE\"`: Creates a content block for use in Engage campaigns.\n- `\"source\": \"INFORM\"`: Creates a content block for use in Inform alerts.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "content-blocks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The 'dc' in the API Endpoint URL refers to the MoEngage Data Center (DC). MoEngage hosts each customer in a different DC. You can find your DC number and replace the value of 'dc' in the URL by referring to the DC and API endpoint mapping [here](/api/introduction#data-centers). Your MoEngage Data Center (DC) can be 01, 02, 03, 04, 05, 06, or 101.",
                  "type": "any",
                  "value": "{{dc}}",
                  "key": "dc"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) This is the Workspace ID of your MoEngage account that must be passed with the request. You can find it in the MoEngage dashboard at **Settings** > **Account** > **APIs** > **Workspace ID (earlier app id)**.\n",
                "key": "MOE-APPKEY",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"label\": \"<string>\",\n  \"raw_content\": \"<string>\",\n  \"content_type\": \"<string>\",\n  \"created_by\": \"<email>\",\n  \"content_block_used\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"status\": \"<string>\",\n  \"description\": \"<string>\",\n  \"tag_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"team_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"images_used\": [\n    \"<uri>\",\n    \"<uri>\"\n  ],\n  \"source\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e3e18642-10fa-4b25-9287-6e718b7baa5d",
              "name": "Success. The response body is empty. To retrieve the ID of the newly created content block, use the Search Content Blocks API.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "content-blocks"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The 'dc' in the API Endpoint URL refers to the MoEngage Data Center (DC). MoEngage hosts each customer in a different DC. You can find your DC number and replace the value of 'dc' in the URL by referring to the DC and API endpoint mapping [here](/api/introduction#data-centers). Your MoEngage Data Center (DC) can be 01, 02, 03, 04, 05, 06, or 101.",
                      "type": "any",
                      "value": "{{dc}}",
                      "key": "dc"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) This is the Workspace ID of your MoEngage account that must be passed with the request. You can find it in the MoEngage dashboard at **Settings** > **Account** > **APIs** > **Workspace ID (earlier app id)**.\n",
                    "key": "MOE-APPKEY",
                    "value": "YOUR_WORKSPACE_ID_XXXX"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Summer_Sale_Header\",\n  \"label\": \"summer_sale_header_2025\",\n  \"description\": \"Header for all summer sale communications\",\n  \"content_type\": \"HTML\",\n  \"raw_content\": \"<h1>Huge Summer Sale!</h1>\",\n  \"images_used\": [],\n  \"status\": \"ACTIVE\",\n  \"created_by\": \"marketing@example.com\",\n  \"content_block_used\": [],\n  \"source\": \"ENGAGE\"\n}",
                  "options": {
